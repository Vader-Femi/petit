+        ]),
+      ),
+    ));
+
+    await tester.tapAt(const Offset(10, 10));
+    expect(tapped, isFalse);
+  });
+}
diff --git a/test/onboarding_test.dart b/test/onboarding_test.dart
new file mode 100644
