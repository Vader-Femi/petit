new file mode 100644
index 0000000..2d4931b
--- /dev/null
+++ b/lib/core/utils/media_formats.dart
@@ -0,0 +1,20 @@
+/// File-extension checks. Anchored to the end of the path and case-insensitive,
+/// unlike the old unescaped-dot regexes (where `.` matched any character).
+final _imageSizeGetterFormats =
+    RegExp(r'\.(png|webp|jpe?g|gif|bmp)$', caseSensitive: false);
+final _heifFormats = RegExp(r'\.(heic|heif)$', caseSensitive: false);
+final _jpegFormats = RegExp(r'\.jpe?g$', caseSensitive: false);
+final _compressibleImageFormats =
+    RegExp(r'\.(png|webp|jpe?g|heic|heif)$', caseSensitive: false);
+
+/// Formats `image_size_getter` can read directly.
+bool isImageSizeGetterSupported(String path) =>
+    _imageSizeGetterFormats.hasMatch(path);
+
+bool isHeif(String path) => _heifFormats.hasMatch(path);
+
+bool isJpeg(String path) => _jpegFormats.hasMatch(path);
+
+/// Formats the image compressor accepts as input.
+bool isCompressibleImage(String path) =>
+    _compressibleImageFormats.hasMatch(path);
diff --git a/lib/core/utils/platform_utils.dart b/lib/core/utils/platform_utils.dart
new file mode 100644
index 0000000..c927094
--- /dev/null
+++ b/lib/core/utils/platform_utils.dart
@@ -0,0 +1,21 @@
+import 'dart:io';
+
+import 'package:flutter/foundation.dart';
+
+/// Central place for platform checks, so the rest of the app never touches
+/// `dart:io`'s `Platform` directly (which throws on web).
+class PlatformInfo {
+  PlatformInfo._();
+
+  static bool get isAndroid => !kIsWeb && Platform.isAndroid;
+  static bool get isIOS => !kIsWeb && Platform.isIOS;
+  static bool get isWindows => !kIsWeb && Platform.isWindows;
+  static bool get isMacOS => !kIsWeb && Platform.isMacOS;
+  static bool get isLinux => !kIsWeb && Platform.isLinux;
+
+  static bool get isMobile => isAndroid || isIOS;
+  static bool get isDesktop => isWindows || isMacOS || isLinux;
+
+  /// Firebase Crashlytics has no Windows or Linux implementation.
+  static bool get supportsCrashlytics => !(isWindows || isLinux);
+}
diff --git a/lib/core/utils/work_dir.dart b/lib/core/utils/work_dir.dart
new file mode 100644
index 0000000..f7b93e9
--- /dev/null
+++ b/lib/core/utils/work_dir.dart
@@ -0,0 +1,67 @@
+import 'dart:io';
+
+import 'package:flutter/foundation.dart';
+import 'package:path/path.dart' as p;
+import 'package:path_provider/path_provider.dart';
+
+import 'platform_utils.dart';
+
+const _workDirName = 'petit_work';
+
+/// Folder owned by Petit for intermediate and output files.
+///
+/// Never write next to the user's original files, and never delete outside
+/// this folder on desktop: there the system temp directory is shared with
+/// other applications.
+Future<Directory> getWorkDir() async {
+  final temp = await getTemporaryDirectory();
+  final dir = Directory(p.join(temp.path, _workDirName));
+  if (!await dir.exists()) {
+    await dir.create(recursive: true);
+  }
+  return dir;
+}
+
+/// Creates a fresh sub-folder for a single compression job, so files inside
+/// can keep clean names (e.g. `photo_compressed.jpg`) without colliding.
+Future<Directory> createJobDir() async {
+  final work = await getWorkDir();
+  final dir = Directory(
+    p.join(work.path, DateTime.now().microsecondsSinceEpoch.toString()),
+  );
+  return dir.create(recursive: true);
+}
+
+/// Removes temporary files created while compressing.
+///
+/// Mobile: the temp directory is the app's private cache, so it is cleared
+/// completely (same as the previous behaviour).
+/// Desktop: only Petit's own work folder is cleared.
+Future<void> clearTempFiles() async {
+  try {
+    final temp = await getTemporaryDirectory();
+    if (!await temp.exists()) return;
+
+    if (PlatformInfo.isMobile) {
+      await _deleteChildren(temp);
+    } else {
+      final work = Directory(p.join(temp.path, _workDirName));
+      if (await work.exists()) {
+        await _deleteChildren(work);
+      }
+    }
+    debugPrint('Temp files cleared');
+  } catch (e) {
+    debugPrint('Error clearing temp files: $e');
+  }
+}
+
+Future<void> _deleteChildren(Directory dir) async {
+  for (final entity in dir.listSync()) {
+    try {
+      await entity.delete(recursive: true);
+    } catch (e) {
+      debugPrint('Failed to delete ${entity.path}: $e');
+    }
+  }
+}
