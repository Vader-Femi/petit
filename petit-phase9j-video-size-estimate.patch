diff --git a/lib/features/videos/domain/usecases/estimate_video_size.dart b/lib/features/videos/domain/usecases/estimate_video_size.dart
new file mode 100644
index 0000000..6d9b265
--- /dev/null
+++ b/lib/features/videos/domain/usecases/estimate_video_size.dart
@@ -0,0 +1,170 @@
+import 'dart:async';
+import 'dart:io';
+
+import 'package:petit/common/domain/media_exception.dart';
+import 'package:petit/features/videos/domain/entities/video_data.dart';
+import 'package:petit/features/videos/domain/services/video_compressor.dart';
+import 'package:petit/features/videos/domain/video_plan.dart';
+import 'package:petit/features/videos/domain/video_sampling.dart';
+
+/// What compressing a video with the chosen settings is expected to produce.
+class VideoSizeEstimate {
+  const VideoSizeEstimate({
+    required this.originalBytes,
+    required this.estimatedBytes,
+    required this.sampledMs,
+    required this.sampleCount,
+    required this.totalMs,
+  });
+
+  final int originalBytes;
+  final int estimatedBytes;
+
+  /// How much of the video was really compressed to work this out.
+  final int sampledMs;
+  final int sampleCount;
+  final int totalMs;
+
+  /// The whole video was compressed, so the size is exact (not extrapolated).
+  bool get isExact => sampledMs >= totalMs;
+
+  /// Compressing is not expected to make the video smaller; the original
+  /// would be kept.
+  bool get isLarger => estimatedBytes >= originalBytes;
+
+  /// Fraction (0..1) of the original size expected to be saved.
+  double get savedFraction => originalBytes <= 0 || isLarger
+      ? 0.0
+      : ((originalBytes - estimatedBytes) / originalBytes)
+          .clamp(0.0, 1.0)
+          .toDouble();
+}
+
+/// An estimate in progress: cancel it, or await [result].
+class VideoEstimateJob {
+  VideoEstimateJob(this.result, this._cancel);
+
+  /// Completes with the estimate, or with a [MediaException] if it failed or
+  /// was cancelled.
+  final Future<VideoSizeEstimate> result;
+  final Future<void> Function() _cancel;
+
+  Future<void> cancel() => _cancel();
+}
+
+/// Predicts how big a video will be by really compressing a few short
+/// stretches of it with the chosen settings, and scaling up their size. Much
+/// more telling than a rule of thumb, because it sees this video's own mix of
+/// calm and busy scenes, and uses the same encoder (hardware or not) as the
+/// real job. Short videos are compressed whole, so the answer is exact.
+class EstimateVideoSizeUseCase {
+  EstimateVideoSizeUseCase(this._compressor);
+
+  final VideoCompressor _compressor;
+
+  /// Takes the same choices as `CompressVideoUseCase`. [onProgress] receives
+  /// 0..100 across all the stretches.
+  Future<VideoEstimateJob> call({
+    required File input,
+    required int qualityPercent,
+    required String preset,
+    int? maxShortSide,
+    int? targetBytes,
+    bool fastEncoding = false,
+    void Function(int percent)? onProgress,
+  }) async {
+    final VideoData data;
+    try {
+      data = await _compressor.probe(input);
+    } on MediaException {
+      throw const MediaException('Error retrieving video properties');
+    }
+
+    final durationMs = data.durationMs;
+    if (durationMs == null || durationMs <= 0) {
+      throw const MediaException(
+          "Could not work out the video's length, so its size cannot be estimated.");
+    }
+
+    final plan = await planVideoEncoding(
+      compressor: _compressor,
+      input: input,
+      data: data,
+      qualityPercent: qualityPercent,
+      maxShortSide: maxShortSide,
+      targetBytes: targetBytes,
+      fastEncoding: fastEncoding,
+    );
+
+    final windows = sampleWindows(durationMs);
+    final run = _Run();
+
+    Future<VideoSizeEstimate> work() async {
+      final sizes = <int>[];
+
+      for (var i = 0; i < windows.length; i++) {
+        if (run.cancelled) {
+          throw const MediaException('Estimate cancelled.');
+        }
+        final window = windows[i];
+
+        final task = await _compressor.start(
+          input: input,
+          videoCodec: plan.videoCodec,
+          crf: plan.crf,
+          preset: preset,
+          videoBitrateKbps: plan.videoBitrateKbps,
+          maxShortSide: plan.maxShortSide,
+          hardwareEncoder: plan.hardwareEncoder,
+          hardwareBitrateKbps: plan.hardwareBitrateKbps,
+          startMs: window.startMs,
+          limitMs: window.lengthMs,
+          totalDurationMs: window.lengthMs,
+          onProgress: (percent) =>
+              onProgress?.call(((i + percent / 100) / windows.length * 100).round()),
+        );
+        run.current = task;
+
+        final File sample;
+        try {
+          sample = await task.result;
+        } on MediaException {
+          if (run.cancelled) throw const MediaException('Estimate cancelled.');
+          rethrow;
+        }
+
+        sizes.add(await sample.length());
+        try {
+          await sample.delete();
+        } on FileSystemException {
+          // Left in the work folder, which is emptied after the next job.
+        }
+      }
+
+      onProgress?.call(100);
+      return VideoSizeEstimate(
+        originalBytes: await input.length(),
+        estimatedBytes: extrapolateBytes(
+          sampleBytes: sizes,
+          windows: windows,
+          durationMs: durationMs,
+        ),
+        sampledMs: windows.fold<int>(0, (sum, w) => sum + w.lengthMs),
+        sampleCount: windows.length,
+        totalMs: durationMs,
+      );
+    }
+
+    return VideoEstimateJob(work(), run.cancel);
+  }
+}
+
+class _Run {
+  bool cancelled = false;
+  VideoCompressionTask? current;
+
+  Future<void> cancel() async {
+    cancelled = true;
+    await current?.cancel();
+  }
+}
diff --git a/lib/features/videos/domain/video_plan.dart b/lib/features/videos/domain/video_plan.dart
new file mode 100644
index 0000000..efabdf0
--- /dev/null
+++ b/lib/features/videos/domain/video_plan.dart
@@ -0,0 +1,112 @@
+import 'dart:io';
+import 'dart:math' as math;
+
+import 'package:petit/common/domain/media_exception.dart';
+import 'package:petit/features/videos/domain/entities/codec_config.dart';
+import 'package:petit/features/videos/domain/entities/video_data.dart';
+import 'package:petit/features/videos/domain/services/video_compressor.dart';
+import 'package:petit/features/videos/domain/video_bitrate.dart';
+
+/// Everything the encoder is told for one video: what compressing it and
+/// estimating its size both need, so they cannot disagree.
+class VideoEncodingPlan {
+  const VideoEncodingPlan({
+    required this.videoCodec,
+    required this.crf,
+    this.videoBitrateKbps,
+    this.maxShortSide,
+    this.hardwareEncoder,
+    this.hardwareBitrateKbps,
+  });
+
+  /// Software encoder, e.g. `libx264`. Also the one used if hardware fails.
+  final String videoCodec;
+  final int crf;
+
+  /// Set for a target size; null means "use [crf]".
+  final int? videoBitrateKbps;
+
+  /// Null when the video is not larger than the chosen resolution.
+  final int? maxShortSide;
+
+  final String? hardwareEncoder;
+  final int? hardwareBitrateKbps;
+}
+
+/// Works out the [VideoEncodingPlan] for [input] (already probed as [data]).
+///
+/// Throws a [MediaException] when the video's properties are missing, or a
+/// target size is asked for but the video's length is unknown.
+///
+/// [qualityPercent] is the 0..100 slider; [targetBytes] aims for a size
+/// instead; [maxShortSide] scales down (never up); [fastEncoding] asks for
+/// the video hardware, used only if this machine has some that works.
+Future<VideoEncodingPlan> planVideoEncoding({
+  required VideoCompressor compressor,
+  required File input,
+  required VideoData data,
+  required int qualityPercent,
+  int? maxShortSide,
+  int? targetBytes,
+  bool fastEncoding = false,
+}) async {
+  if (data.frameRate == null ||
+      data.pixelHeight == null ||
+      data.pixelWidth == null ||
+      data.videoCodec == null) {
+    throw const MediaException('Error retrieving video properties');
+  }
+
+  final config = getVcodecConfigFromCodec(data.videoCodec!);
+  final crf = (config.minCrf +
+          ((qualityPercent / 100) * (config.maxCrf - config.minCrf)))
+      .round();
+
+  int? videoBitrateKbps;
+  if (targetBytes != null) {
+    final durationMs = data.durationMs;
+    if (durationMs == null || durationMs <= 0) {
+      throw const MediaException(
+          "Could not work out the video's length, so a target size is not possible. Use quality instead.");
+    }
+    videoBitrateKbps =
+        bitrateForTargetSize(targetBytes: targetBytes, durationMs: durationMs);
+  }
+
+  final shortSide = math.min(data.pixelWidth!, data.pixelHeight!);
+  final scaleTo =
+      (maxShortSide != null && shortSide > maxShortSide) ? maxShortSide : null;
+
+  String? hardwareEncoder;
+  int? hardwareBitrateKbps;
+  if (fastEncoding) {
+    hardwareEncoder = await compressor.hardwareEncoderFor(config.vcodec);
+    if (hardwareEncoder != null) {
+      hardwareBitrateKbps = videoBitrateKbps ??
+          fastEncodingBitrateKbps(
+            width: data.pixelWidth!,
+            height: data.pixelHeight!,
+            frameRate: data.frameRate,
+            crf: crf,
+            hevc: config.vcodec == 'libx265',
+            maxShortSide: scaleTo,
+            sourceKbps: await _sourceKbps(input, data.durationMs),
+          );
+    }
+  }
+
+  return VideoEncodingPlan(
+    videoCodec: config.vcodec,
+    crf: crf,
+    videoBitrateKbps: videoBitrateKbps,
+    maxShortSide: scaleTo,
+    hardwareEncoder: hardwareEncoder,
+    hardwareBitrateKbps: hardwareBitrateKbps,
+  );
+}
+
+/// The video's own average bitrate, or null when its length is unknown.
+Future<int?> _sourceKbps(File input, int? durationMs) async {
+  if (durationMs == null || durationMs <= 0) return null;
+  return ((await input.length()) * 8 / durationMs).round();
+}
diff --git a/lib/features/videos/domain/video_sampling.dart b/lib/features/videos/domain/video_sampling.dart
new file mode 100644
index 0000000..fa4e4af
--- /dev/null
+++ b/lib/features/videos/domain/video_sampling.dart
@@ -0,0 +1,70 @@
+/// A short stretch of a video, in milliseconds from its start.
+class SampleWindow {
+  const SampleWindow(this.startMs, this.lengthMs);
+
+  final int startMs;
+  final int lengthMs;
+
+  @override
+  bool operator ==(Object other) =>
+      other is SampleWindow &&
+      other.startMs == startMs &&
+      other.lengthMs == lengthMs;
+
+  @override
+  int get hashCode => Object.hash(startMs, lengthMs);
+
+  @override
+  String toString() => 'SampleWindow($startMs, $lengthMs)';
+}
+
+/// Videos this short (or shorter) are not sampled: the "sample" is the whole
+/// video, so the estimate is exact.
+const int kWholeVideoMaxMs = 8000;
+
+/// How many places in a longer video are tried.
+const int kSampleCount = 3;
+
+/// How long each try is.
+const int kSampleMs = 2000;
+
+/// Where to try a video of [durationMs] to predict how big it will get.
+///
+/// A few short stretches spread over the video (a sixth, half and five sixths
+/// of the way in) catch more of its variety than one long one: most videos
+/// have calm and busy parts, and busy parts cost more bytes.
+List<SampleWindow> sampleWindows(
+  int durationMs, {
+  int count = kSampleCount,
+  int sampleMs = kSampleMs,
+}) {
+  if (durationMs <= kWholeVideoMaxMs || count < 1) {
+    return [SampleWindow(0, durationMs)];
+  }
+
+  return [
+    for (var i = 0; i < count; i++)
+      SampleWindow(
+        ((durationMs * (i + 0.5) / count) - sampleMs / 2)
+            .round()
+            .clamp(0, durationMs - sampleMs)
+            .toInt(),
+        sampleMs,
+      ),
+  ];
+}
+
+/// The size of the whole video, from the sizes the [windows] came out at: the
+/// bytes per second of the samples, over the whole length. Audio and the file
+/// container are in the samples too, so nothing is added.
+int extrapolateBytes({
+  required List<int> sampleBytes,
+  required List<SampleWindow> windows,
+  required int durationMs,
+}) {
+  assert(sampleBytes.length == windows.length);
+  final sampledMs = windows.fold<int>(0, (sum, w) => sum + w.lengthMs);
+  if (sampledMs <= 0) return 0;
+  final bytes = sampleBytes.fold<int>(0, (sum, b) => sum + b);
+  return (bytes / sampledMs * durationMs).round();
+}
