+import 'dart:io';
+
+import 'package:path/path.dart' as p;
+import 'package:petit/core/utils/media_formats.dart';
+import 'package:petit/core/utils/work_dir.dart';
+import 'package:petit/features/images/data/services/desktop_heif_converter.dart';
+import 'package:petit/features/images/domain/services/image_previewer.dart';
+
+/// HEIC previews on desktop: a screen-sized JPEG next to the work files.
+class DesktopImagePreviewer implements ImagePreviewer {
+  DesktopImagePreviewer(this._converter);
+
+  /// Big enough for the carousel on a large monitor.
+  static const maxLongSide = 1600;
+
+  final DesktopHeifConverter _converter;
+
+  @override
+  Future<File?> createPreview(String path) async {
+    if (!isHeif(path)) return null;
+
+    try {
+      final jobDir = await createJobDir();
+      final out = p.join(jobDir.path, '${p.basenameWithoutExtension(path)}_preview.jpg');
+      return await _converter.toJpeg(path, out, maxLongSide: maxLongSide)
+          ? File(out)
+          : null;
+    } catch (_) {
+      return null;
+    }
+  }
+}
diff --git a/lib/features/images/data/services/heif_arguments.dart b/lib/features/images/data/services/heif_arguments.dart
new file mode 100644
index 0000000..535139b
--- /dev/null
+++ b/lib/features/images/data/services/heif_arguments.dart
@@ -0,0 +1,30 @@
+// Pure Dart (no plugins), so the command line can be unit tested.
+
+/// The FFmpeg command line (without the program name) that turns the first
+/// image of a HEIC/HEIF file into a high quality JPEG.
+///
+/// With [maxLongSide] the picture is scaled down so its longer side has at
+/// most that many pixels (never enlarged), which is what a preview needs.
+/// FFmpeg applies the file's rotation itself. Commas are escaped for FFmpeg's
+/// filter syntax.
+List<String> buildHeifToJpegArguments({
+  required String inputPath,
+  required String outputPath,
+  int? maxLongSide,
+}) {
+  return [
+    '-y',
+    '-i',
+    inputPath,
+    '-frames:v',
+    '1',
+    if (maxLongSide != null) ...[
+      '-vf',
+      'scale=w=if(gt(iw\\,ih)\\,min(iw\\,$maxLongSide)\\,-2)'
+          ':h=if(gt(iw\\,ih)\\,-2\\,min(ih\\,$maxLongSide))',
+    ],
+    '-q:v',
+    '2',
+    outputPath,
+  ];
+}
